{
	//是否为测试模式(测试模式会为消息打时间戳)
	// 对齐资料包 OESAPI-JAVA-v0.19.4.0 all/config/mds_api_config.json；TCP 为阿里云模拟示例（非实盘）
	"testMode": false,
    //通道事件监听
    "SELECTOR": {
    	//选择器阻塞时长(毫秒)
    	"timeout": "50MS",
    	//心跳检查间隔时间(秒)
		"checkHeartBeat": "5S",
		//统计信息打印间隔时间(秒)(等于0S则不打印)
		"printStatsInfo": "300S",
		//是否统计处理延迟
		"isLatencyStats": false,
		//回调任务队列大小
        "callBackTaskQueueCapacity": 200000
    },
    //MDS客户端
    "MDSCLIENT": {
    	//是否为开发模式: true:开发模式,解码错误直接抛异常断连; false:生产模式，解码错误打印错误日志保持连接
    	//注:如果需要低版本API兼容高版本服务器协议也需要设置为false
        "devMode": false,
        // 是否同类型消息首次解码失败时打印日志(生产模式下(devMode = false)时才会生效)
        "firstDecodeFailLog": true,
    	// 客户端环境号, 取值由客户端自行分配
    	// 取值范围 [0~99] ( [100~127] 为保留区间，不可使用 )
    	"clEnvId": 99,
    	// 客户端设备序列号(硬盘序列号)
    	"clDriverId": "YOUR_CL_DRIVER_ID",
    	// 是否启用UDP行情订阅（公网阿里云模拟通常不可用，默认关）
    	"isUdpSubMktEnable": false,
    	//行情通道
        "mktChannel": {
        	//连接超时设置(毫秒)
			"connTimeout": "3000MS",
			//同步读超时设置(毫秒)
			"synReadTimeout": "3000MS",
        	//TCP 接收缓存大小(实际大小需看系统环境配置)
	    	"so_rcv_buf": "8M",
	    	//TCP 发送缓存大小
	    	"so_snd_buf": "256K",
	    	//读-字节缓冲大小
	    	"read_buf_size": "32M",
	    	//读-字节缓冲最小可用预留大小
	    	"min_usable_buf_size": "8K",
	    	//写-字节缓冲大小
	    	"write_buf_size": "512K",
	    	//请求缓存队列大小
	    	"reqMsgQueueSize": 100,
	    	//行情回报消息缓存队列大小
	    	"rspMsgQueueSize": 10000,
	    	//是否可丢弃消息(在行情波峰时段,如果客户实现的行情回调处理用时过多可能会造成行情数据积压,
		    //该配置可选择是否主动丢弃接收队列中较旧的行情数据,以保障对最新的行情数据接收)
	    	"isDropable": false,
	    	//每次丢弃消息数量("isDropable"为true时起作用)
	    	"dropNum": 1,
    		//服务地址配置   *注: 1. hostNum目前不起做用; 2.addr、part要与OES的配置相对应; 3.可配多个主备地址，按实际情况进行配置;
            // 阿里云模拟（非实盘）示例：139.196.228.232:5103；UDP 组播公网通常不可用
            "address": [
            {"hostNum": 1, "addr": "139.196.228.232", "port": "5103"},
            {"hostNum": 2, "addr": "139.196.228.232", "port": "5103"}
            ]
        },
        //查询通道
        "queryChannel": {
        	"connTimeout": "3000MS",
			"synReadTimeout": "3000MS",
	    	"so_rcv_buf": "2M",
	    	"so_snd_buf": "1M",
	    	"read_buf_size": "1M",
	    	"min_usable_buf_size": "8K",
	    	"write_buf_size": "512K",
            "address": [
            {"hostNum": 1, "addr": "139.196.228.232", "port": "5203"},
            {"hostNum": 2, "addr": "139.196.228.232", "port": "5203"}
            ]
        },
        //组播UDP行情通道集合
        //注:UDP行情接收占用内存较大建议将堆栈默认和最大空间设置为6G以上
        // 0.19.4：原 addr/port 组播配置项已废弃，仅 bindAddr；公网模拟请保持 enable=false
        "mktUdpChannels": [
            {
            	"desc": "SNAP1",
            	"enable": false,
		    	"so_rcv_buf": "12M",
		    	"read_buf_size": "24M",
		    	"min_usable_buf_size": "2K",
		    	"rspMsgQueueSize": 5000,
		    	"singleMaxRcvPktSize": 0,
		    	"isDropable": false,
		    	"dropNum": 1,
	            "address": {"bindAddr": "YOUR_LOCAL_BIND_IP"}
        	},
        	{
                "desc": "SNAP2",
            	"enable": false,
                "so_rcv_buf": "12M",
                "read_buf_size": "24M",
                "min_usable_buf_size": "2K",
                "rspMsgQueueSize": 5000,
                "singleMaxRcvPktSize": 0,
                "isDropable": false,
                "dropNum": 1,
                "address": {"bindAddr": "YOUR_LOCAL_BIND_IP"}
            },
        	{
        		"desc": "TICK1",
        		"enable": false,
	        	"so_rcv_buf": "12M",
		    	"read_buf_size": "32M",
		    	"min_usable_buf_size": "2K",
		    	"rspMsgQueueSize": 10000,
		    	"singleMaxRcvPktSize": 0,
		    	"isDropable": false,
		    	"dropNum": 1,
	    		"address": {"bindAddr": "YOUR_LOCAL_BIND_IP"}
        	},
        	{
        		"desc": "TICK2",
        		"enable": false,
	        	"so_rcv_buf": "12M",
		    	"read_buf_size": "32M",
		    	"min_usable_buf_size": "2K",
		    	"rspMsgQueueSize": 10000,
		    	"singleMaxRcvPktSize": 0,
		    	"isDropable": false,
		    	"dropNum": 1,
	    		"address": {"bindAddr": "YOUR_LOCAL_BIND_IP"}
        	},
        	{
                "desc": "LOB_SNAP1",
                "enable": false,
                "so_rcv_buf": "12M",
                "read_buf_size": "24M",
                "min_usable_buf_size": "2K",
                "rspMsgQueueSize": 5000,
                "singleMaxRcvPktSize": 0,
                "isDropable": false,
                "dropNum": 1,
                "address": {"bindAddr": "YOUR_LOCAL_BIND_IP"}
            },
            {
                "desc": "LOB_SNAP2",
                "enable": false,
                "so_rcv_buf": "12M",
                "read_buf_size": "24M",
                "min_usable_buf_size": "2K",
                "rspMsgQueueSize": 5000,
                "singleMaxRcvPktSize": 0,
                "isDropable": false,
                "dropNum": 1,
                "address": {"bindAddr": "YOUR_LOCAL_BIND_IP"}
            }
        ]
    }
}
